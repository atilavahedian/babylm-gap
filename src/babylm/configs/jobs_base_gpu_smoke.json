{
 "description": "CUDA smoke of all base levers (60 steps, small, compiled); not a tuning trial",
 "jobs": [
  {
   "name": "base_gpu_smoke_levers",
   "module": "babylm.harness.train",
   "args": [
    "--model",
    "baseline",
    "--size",
    "small",
    "--split",
    "train_10M",
    "--epochs",
    "10",
    "--seed",
    "0",
    "--batch_tokens",
    "65536",
    "--seq_len",
    "1024",
    "--lr_batch_scaling",
    "none",
    "--muon_lr",
    "0.065",
    "--lr_embed",
    "0.78",
    "--lr_head",
    "0.0208",
    "--lr_scalar",
    "0.052",
    "--muon_momentum",
    "0.95",
    "--muon_momentum_start",
    "0.85",
    "--muon_momentum_warmup_steps",
    "150",
    "--adam_beta1",
    "0.8",
    "--adam_beta2",
    "0.95",
    "--warmup_steps",
    "0",
    "--cooldown_frac",
    "0.5",
    "--lr_floor",
    "0.1",
    "--muon_wd",
    "0",
    "--adam_wd",
    "0",
    "--extra",
    "softcap=15",
    "--extra",
    "unet=true",
    "--compile",
    "--window_plan",
    "line:128x6,line:256x2,line:512x2",
    "--mntp_frac",
    "0.25",
    "--ema_decay",
    "0.999",
    "--steps",
    "60",
    "--milestone_scale",
    "0.01",
    "--resume",
    "auto",
    "--tag",
    "base_gpu_smoke_levers",
    "--no_pt"
   ],
   "timeout_s": 1800
  }
 ]
}
